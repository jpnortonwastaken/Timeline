{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Timelime",
  "version": "0.1.1",
  "identifier": "com.jpn.timelime",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Timelime",
        "width": 1320,
        "height": 860,
        "minWidth": 720,
        "minHeight": 460,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "trafficLightPosition": {
          "x": 16.5,
          "y": 24.5
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: asset: http://asset.localhost https://lh3.googleusercontent.com; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com; frame-src 'none'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Timelime",
    "longDescription": "A timeline for planning projects and a whole life on one canvas.",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1ODFFOTIyQzYzMTY3NDgKUldSSVp6SEdJdW1CNVpySHpGWDFabHVtYjJVMWg4WDJyeWlUMjljcWF3dFdFTHFBd1BOUFBCL2gK",
      "endpoints": [
        "https://github.com/jpnortonwastaken/Timeline/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
