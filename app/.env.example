# Copy to `.env` and fill in from the Firebase console. See README > Cloud sync.
#
# None of the VITE_FIREBASE_* values are secrets - Firebase ships them in every
# web client it generates, and they identify the project rather than authorise
# anything. What protects the data is `firestore.rules`.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Cloud > APIs & Services > Credentials > OAuth client, type "Desktop app".
# Must live in the same project as Firebase, or Firebase will not accept the
# ID token it issues.
#
# Google's own docs say a desktop client secret cannot be kept confidential in
# an app you distribute. PKCE is what secures the exchange; this is only sent
# because Google's token endpoint still asks for it.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
